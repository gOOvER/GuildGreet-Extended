package-as: GuildGreet
enable-nolib-creation: yes
enable-toc-creation: yes

externals:
    libs/LibStub:
        url: https://github.com/WoWUIDev/Ace3
        path: LibStub
    libs/CallbackHandler-1.0:
        url: https://github.com/WoWUIDev/Ace3
        path: CallbackHandler-1.0
    libs/AceAddon-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceAddon-3.0
    libs/AceEvent-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceEvent-3.0
    libs/AceTimer-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceTimer-3.0
    libs/AceHook-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceHook-3.0
    libs/AceDB-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceDB-3.0
    libs/AceDBOptions-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceDBOptions-3.0
    libs/AceLocale-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceLocale-3.0
    libs/AceConsole-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceConsole-3.0
    libs/AceGUI-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceGUI-3.0
    libs/AceConfig-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceConfig-3.0
    libs/AceComm-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceComm-3.0
    libs/AceTab-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceTab-3.0
    libs/AceSerializer-3.0:
        url: https://github.com/WoWUIDev/Ace3
        path: AceSerializer-3.0
    libs/LibDataBroker-1.1:
        url: https://github.com/tekkub/libdatabroker-1-1
    libs/LibDBIcon-1.0:
        url: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    libs/LibSharedMedia-3.0:
        url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3-0

manual-changelog: CHANGELOG.md
license-output: LICENSE.md

ignore:
    - .github
    - .gitignore
    - .gitattributes
    - .luacheckrc
    - .pkgmeta
    - CHANGELOG.md
    - README.md
    - LICENSE
    - LICENCE.md
    - GuildGreet.xml
    - missing_strings.txt
    - used_strings.txt
